<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BSBKTV 실시간 트렌드 상황실</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        :root { --neon-green: #0f0; --dark-bg: #000; --score-color: #ff0; }
        body { 
            background-color: var(--dark-bg); 
            color: var(--neon-green); 
            font-family: 'Courier New', monospace; 
            padding: 20px; 
            line-height: 1.6;
        }
        .header { border-bottom: 2px solid var(--neon-green); padding-bottom: 10px; margin-bottom: 20px; }
        .keyword-card { 
            border: 1px solid var(--neon-green); 
            padding: 15px; 
            margin-bottom: 12px; 
            border-radius: 4px; 
            background: rgba(0, 255, 0, 0.05);
            animation: fadeIn 0.5s ease-in-out;
        }
        .score { float: right; color: var(--score-color); font-weight: bold; }
        .status { color: #fff; background: #333; padding: 2px 6px; border-radius: 3px; font-size: 0.8em; }
        .timestamp { font-size: 0.7em; color: #888; display: block; margin-top: 5px; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>
    <div class="header">
        <h1>[ BSBKTV VIRAL DATA CENTER ]</h1>
        <p>SYSTEM STATUS: <span id="sync-status" style="color: #0ff;">SYNCHRONIZING...</span></p>
    </div>

    <div id="display-container">
        </div>

    <script>
        // 마스터님이 제공하신 무결성 접속 정보
        const SUPABASE_URL = 'https://dmjaxhydwaumhujrculd.supabase.co';
        const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRtamF4aHlkd2F1bWh1anJjdWxkIiwicm9sZSI6ImRtamF4aHlkd2F1bWh1anJjdWxkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjQ3MTEyNTgsImV4cCI6MjA4MDI4NzI1OH0.nTdfW9Iw3OLyYbWcPGU2T8P_i-9tDeqUn1t2cAsIbn0';
        
        const _supabase = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

        async function fetchMasterTrends() {
            const statusTag = document.getElementById('sync-status');
            statusTag.innerText = 'FETCHING...';
            statusTag.style.color = '#ff0';

            // 1. trending_keywords 테이블에서 최신 데이터 10개 추출
            const { data, error } = await _supabase
                .from('trending_keywords')
                .select('*')
                .order('created_at', { ascending: false })
                .limit(10);

            if (error) {
                console.error('Data Center Error:', error);
                statusTag.innerText = 'OFFLINE';
                statusTag.style.color = '#f00';
                return;
            }

            if (data) {
                const container = document.getElementById('display-container');
                container.innerHTML = data.map(v => `
                    <div class="keyword-card">
                        <span class="score">VIRAL: ${v.viral_score}</span>
                        <span class="status">${v.status}</span>
                        <div style="font-size: 1.2em; margin: 10px 0;">> ${v.keyword}</div>
                        <span class="timestamp">LAST_SYNC: ${new Date(v.created_at).toLocaleString()}</span>
                    </div>
                `).join('');
                
                statusTag.innerText = 'ONLINE';
                statusTag.style.color = '#0ff';
            }
        }

        // 초기 실행 및 1분(60000ms) 간격 무한 루프
        fetchMasterTrends();
        setInterval(fetchMasterTrends, 60000);
    </script>
</body>
</html>
